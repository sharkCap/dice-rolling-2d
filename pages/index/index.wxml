<view class="page">
  <view class="topbar">
    <view>
      <text class="eyebrow">{{labelEyebrow}}</text>
      <text class="title">{{labelTitle}}</text>
    </view>
  </view>

  <view class="table">
    <view class="table-rim">
      <view class="dice-zone {{rolling ? 'is-rolling' : ''}} {{covered ? 'is-covered' : ''}}">
        <view class="dice-cluster dice-count-{{diceCount}}">
          <view wx:for="{{dice}}" wx:key="id" class="die value-{{item.value}} die-{{index}}">
            <view class="pip pip-1"></view>
            <view class="pip pip-2"></view>
            <view class="pip pip-3"></view>
            <view class="pip pip-4"></view>
            <view class="pip pip-5"></view>
            <view class="pip pip-6"></view>
            <view class="pip pip-7"></view>
            <view class="pip pip-8"></view>
            <view class="pip pip-9"></view>
          </view>
        </view>

        <view class="cup-mask {{covered ? 'show' : 'lifted'}} {{rolling ? 'shake' : ''}}" bindtap="revealDice">
          <view class="cup-lip"></view>
          <view class="cup-body">
            <text class="cup-mark">{{labelOpen}}</text>
          </view>
          <view class="cup-shadow"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="result-panel">
    <text class="status">{{statusText}}</text>
    <view class="result-line">
      <text class="result-label">{{labelScore}}</text>
      <text class="result-value">{{covered ? '--' : total}}</text>
    </view>
  </view>

  <button class="count-select-button" bindtap="openCountPicker" disabled="{{rolling}}">
    {{diceCountText}}
  </button>

  <button class="primary-button" bindtap="primaryAction" disabled="{{rolling}}">
    {{primaryText}}
  </button>

  <view wx:if="{{countPickerVisible}}" class="modal-backdrop" bindtap="closeCountPicker">
    <view class="count-sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{labelSheetTitle}}</text>
      </view>
      <view class="count-grid">
        <button
          wx:for="{{countOptions}}"
          wx:key="count"
          class="count-option {{diceCount === item.count ? 'active' : ''}}"
          data-count="{{item.count}}"
          bindtap="selectDiceCount"
        >
          {{item.label}}
        </button>
      </view>
    </view>
  </view>
</view>
