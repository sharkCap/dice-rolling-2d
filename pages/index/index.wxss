page {
  height: 100vh;
  overflow: hidden;
  background: #101114;
  color: #f6efe4;
}

.page {
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  padding: 32rpx 32rpx 34rpx;
}

.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.eyebrow,
.title,
.count-number,
.count-label,
.status,
.result-label,
.result-value,
.sheet-title {
  display: block;
}

.eyebrow {
  margin-bottom: 10rpx;
  color: #c99d55;
  font-size: 22rpx;
  font-weight: 800;
}

.title {
  color: #ffffff;
  font-size: 62rpx;
  font-weight: 900;
  line-height: 1.05;
}

.mode-entry {
  min-width: 176rpx;
  height: 68rpx;
  margin: 10rpx 0 0;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 2rpx solid rgba(240, 195, 108, 0.62);
  border-radius: 8rpx;
  background: #1a1d24;
  color: #f6efe4;
  font-size: 24rpx;
  font-weight: 800;
  line-height: normal;
  box-sizing: border-box;
}

.mode-entry-mark {
  color: #f0c36c;
  font-size: 27rpx;
  font-weight: 900;
}

.count-button {
  width: 154rpx;
  height: 112rpx;
  margin: 0;
  padding: 14rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(246, 239, 228, 0.22);
  border-radius: 8rpx;
  background: #1a1d24;
  color: #f6efe4;
  box-sizing: border-box;
  line-height: normal;
}

.count-number {
  color: #f0c36c;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.count-label {
  margin-top: 8rpx;
  color: #98a2b0;
  font-size: 22rpx;
  line-height: 1.1;
}

.table {
  padding: 18rpx;
  border-radius: 8rpx;
  background: #2e2118;
  box-shadow: inset 0 0 0 4rpx #4a3423, 0 20rpx 40rpx rgba(0, 0, 0, 0.34);
}

.table-rim {
  height: 640rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #3d4350;
  border-radius: 8rpx;
  background: #22252d;
  box-sizing: border-box;
}

.dice-zone {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.dice-cluster {
  width: 520rpx;
  height: 330rpx;
  position: relative;
  z-index: 2;
}

.die {
  width: 112rpx;
  height: 112rpx;
  position: absolute;
  border: 3rpx solid #ded6ca;
  border-radius: 18rpx;
  background: #fffaf2;
  box-shadow: inset -8rpx -10rpx 0 #e2d8c9, inset 6rpx 6rpx 0 #ffffff, 0 12rpx 16rpx rgba(0, 0, 0, 0.26);
  transition: opacity 120ms ease, transform 120ms ease;
}

.die-small {
  width: 86rpx;
  height: 86rpx;
  border-radius: 15rpx;
  box-shadow: inset -7rpx -8rpx 0 #e2d8c9, inset 5rpx 5rpx 0 #ffffff, 0 10rpx 14rpx rgba(0, 0, 0, 0.24);
}

.is-rolling .die {
  opacity: 0.82;
}

.pip {
  width: 18rpx;
  height: 18rpx;
  position: absolute;
  display: none;
  border-radius: 50%;
  background: #1c2427;
  box-shadow: inset 3rpx 3rpx 0 rgba(255, 255, 255, 0.18);
}

.pip-1,
.pip-2,
.pip-3 {
  top: 20rpx;
}

.pip-4,
.pip-5,
.pip-6 {
  top: 43rpx;
}

.pip-7,
.pip-8,
.pip-9 {
  bottom: 20rpx;
}

.pip-1,
.pip-4,
.pip-7 {
  left: 20rpx;
}

.pip-2,
.pip-5,
.pip-8 {
  left: 43rpx;
}

.pip-3,
.pip-6,
.pip-9 {
  right: 20rpx;
}

.die-normal .pip {
  width: 20rpx;
  height: 20rpx;
}

.die-normal .pip-1,
.die-normal .pip-2,
.die-normal .pip-3 {
  top: 22rpx;
}

.die-normal .pip-4,
.die-normal .pip-5,
.die-normal .pip-6 {
  top: 46rpx;
}

.die-normal .pip-7,
.die-normal .pip-8,
.die-normal .pip-9 {
  bottom: 22rpx;
}

.die-normal .pip-1,
.die-normal .pip-4,
.die-normal .pip-7 {
  left: 22rpx;
}

.die-normal .pip-2,
.die-normal .pip-5,
.die-normal .pip-8 {
  left: 46rpx;
}

.die-normal .pip-3,
.die-normal .pip-6,
.die-normal .pip-9 {
  right: 22rpx;
}

.die-small .pip {
  width: 14rpx;
  height: 14rpx;
}

.die-small .pip-1,
.die-small .pip-2,
.die-small .pip-3 {
  top: 16rpx;
}

.die-small .pip-4,
.die-small .pip-5,
.die-small .pip-6 {
  top: 35rpx;
}

.die-small .pip-7,
.die-small .pip-8,
.die-small .pip-9 {
  bottom: 16rpx;
}

.die-small .pip-1,
.die-small .pip-4,
.die-small .pip-7 {
  left: 16rpx;
}

.die-small .pip-2,
.die-small .pip-5,
.die-small .pip-8 {
  left: 35rpx;
}

.die-small .pip-3,
.die-small .pip-6,
.die-small .pip-9 {
  right: 16rpx;
}

.value-1 .pip-5,
.value-2 .pip-1,
.value-2 .pip-9,
.value-3 .pip-1,
.value-3 .pip-5,
.value-3 .pip-9,
.value-4 .pip-1,
.value-4 .pip-3,
.value-4 .pip-7,
.value-4 .pip-9,
.value-5 .pip-1,
.value-5 .pip-3,
.value-5 .pip-5,
.value-5 .pip-7,
.value-5 .pip-9,
.value-6 .pip-1,
.value-6 .pip-3,
.value-6 .pip-4,
.value-6 .pip-6,
.value-6 .pip-7,
.value-6 .pip-9 {
  display: block;
}

.value-1 .pip,
.value-4 .pip {
  background: #c62828;
}

.cup-mask {
  width: 580rpx;
  height: 440rpx;
  position: absolute;
  left: 50%;
  z-index: 4;
  transform: translateX(-50%);
  transition: top 140ms ease, opacity 160ms ease;
  touch-action: none;
}

.cup-mask.lifted {
  opacity: 1;
}

.cup-mask.show {
  opacity: 1;
}

.cup-mask.shake {
  animation: cup-shake 130ms linear infinite;
}

.cup-mask.dragging {
  transition: none;
}

.cup-lip {
  width: 396rpx;
  height: 70rpx;
  margin: 0 auto -18rpx;
  border: 4rpx solid #631e1b;
  border-radius: 50%;
  background: #b43d34;
  box-sizing: border-box;
}

.cup-body {
  width: 488rpx;
  height: 346rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border: 4rpx solid #631e1b;
  border-radius: 44rpx 44rpx 112rpx 112rpx;
  background: #8f2b26;
  box-shadow: inset 42rpx 0 0 rgba(255, 255, 255, 0.08), inset -48rpx -24rpx 0 rgba(0, 0, 0, 0.18), 0 24rpx 28rpx rgba(0, 0, 0, 0.34);
  box-sizing: border-box;
}

.cup-mark {
  color: rgba(255, 244, 232, 0.84);
  font-size: 78rpx;
  font-weight: 900;
}

.cup-shadow {
  width: 490rpx;
  height: 54rpx;
  margin: -26rpx auto 0;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.3);
}

.result-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  min-height: 96rpx;
  margin: 26rpx 0 22rpx;
}

.status {
  flex: 1;
  color: #b7c0cc;
  font-size: 27rpx;
  line-height: 1.4;
}

.result-line {
  min-width: 140rpx;
  padding: 14rpx 16rpx;
  border: 2rpx solid rgba(246, 239, 228, 0.2);
  border-radius: 8rpx;
  background: #1a1d24;
  text-align: center;
  box-sizing: border-box;
}

.result-label {
  margin-bottom: 6rpx;
  color: #98a2b0;
  font-size: 22rpx;
}

.result-value {
  color: #f0c36c;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.count-select-button,
.primary-button {
  width: 100%;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-weight: 900;
  line-height: normal;
}

.count-select-button {
  height: 82rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid rgba(246, 239, 228, 0.22);
  background: #1a1d24;
  color: #f6efe4;
  font-size: 30rpx;
}

.auto-row {
  min-height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 28rpx;
  padding: 14rpx 18rpx;
  border: 2rpx solid rgba(246, 239, 228, 0.18);
  border-radius: 8rpx;
  background: #1a1d24;
  box-sizing: border-box;
}

.auto-title,
.auto-desc {
  display: block;
}

.auto-title {
  color: #f6efe4;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.auto-desc {
  margin-top: 6rpx;
  color: #98a2b0;
  font-size: 22rpx;
  line-height: 1.25;
}

.primary-button {
  height: 106rpx;
  background: #b43d34;
  color: #fff8ed;
  font-size: 34rpx;
}

.modal-backdrop {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.56);
}

.count-sheet {
  width: 100%;
  padding: 30rpx 32rpx 46rpx;
  border-radius: 20rpx 20rpx 0 0;
  background: #171920;
  box-sizing: border-box;
}

.sheet-head {
  margin-bottom: 24rpx;
  text-align: center;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 900;
}

.count-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
  justify-items: stretch;
}

.count-option {
  height: 96rpx;
  width: 100%;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(246, 239, 228, 0.22);
  border-radius: 8rpx;
  background: #22262e;
  color: #f6efe4;
  font-size: 29rpx;
  font-weight: 800;
  line-height: normal;
}

.count-option.active {
  border-color: #f0c36c;
  background: #3d3524;
  color: #ffffff;
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: 0.62;
}

@keyframes cup-shake {
  0% {
    transform: translateX(-51%) rotate(-3deg);
  }

  50% {
    transform: translateX(-49%) rotate(3deg);
  }

  100% {
    transform: translateX(-51%) rotate(-3deg);
  }
}
